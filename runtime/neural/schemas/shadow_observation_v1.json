{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "neural.shadow_observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "lane", "seed", "step_index", "scenario_id", "external_input_hash", "pair_id", "authority_mode", "decision_influence", "admission_status", "admission_reason", "candidate_output_hash", "candidate_output_hashes_by_organ", "effective_output_hash", "authoritative_decision_hash", "action_hash", "outcome_hash", "behavior_hash", "resource_cost_hash", "candidate_count", "candidate_applied_count", "fallback_used", "certification_status", "timestamp_monotonic_ns", "trace_parent"],
  "properties": {
    "schema_version": {"const": "neural.shadow_observation.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["off", "shadow"]},
    "seed": {"type": "integer"},
    "step_index": {"type": "integer", "minimum": 0},
    "scenario_id": {"type": "string"},
    "external_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_mode": {"enum": ["off", "shadow"]},
    "decision_influence": {"const": "none"},
    "admission_status": {"enum": ["not_evaluated", "admitted", "rejected", "unavailable", "error"]},
    "admission_reason": {"type": "string"},
    "candidate_output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_output_hashes_by_organ": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "effective_output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authoritative_decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "behavior_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource_cost_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidate_applied_count": {"const": 0},
    "fallback_used": {"type": "boolean"},
    "certification_status": {"type": ["string", "null"]},
    "timestamp_monotonic_ns": {"type": "integer", "minimum": 0},
    "trace_parent": {"type": "string", "minLength": 1}
  }
}
