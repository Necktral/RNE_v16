{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n4-ranking-artifact.v2.schema.json",
  "title": "N4 ranking artifact v2",
  "type": "object",
  "required": [
    "schema",
    "model_kind",
    "ranking_objective",
    "dtype",
    "feature_order",
    "feature_transform",
    "model",
    "calibration",
    "dataset_lineage",
    "training_provenance",
    "validation_metrics",
    "holdout_metrics",
    "gates"
  ],
  "properties": {
    "schema": {"const": "n4-ranking-artifact.v2"},
    "model_kind": {"const": "trained_multihead"},
    "ranking_objective": {"const": "pairwise_constrained_v1"},
    "dtype": {"const": "float32"},
    "feature_order": {
      "const": [
        "empirical_gain",
        "holdout_support",
        "coverage",
        "simplicity",
        "stability",
        "invariant_safety"
      ]
    },
    "feature_transform": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"const": "identity"}},
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["trunk", "heads"],
      "properties": {
        "trunk": {
          "type": "object",
          "required": ["layers"],
          "properties": {
            "layers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "input_dim", "output_dim", "activation", "weights", "bias"
                ]
              }
            }
          }
        },
        "heads": {
          "type": "object",
          "required": ["rank", "validity", "gain", "risk"]
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": ["kind", "target", "a", "b", "fit_split"],
      "properties": {
        "kind": {"const": "platt"},
        "target": {"const": "validity_logit"},
        "a": {"type": "number", "exclusiveMinimum": 0},
        "b": {"type": "number"},
        "fit_split": {"const": "validation"}
      }
    },
    "dataset_lineage": {"type": "object"},
    "training_provenance": {"type": "object"},
    "validation_metrics": {"type": "object"},
    "holdout_metrics": {"type": "object"},
    "gates": {
      "type": "object",
      "required": [
        "artifact_quality",
        "calibration",
        "risk_target_informative",
        "scientific_holdout",
        "promotable"
      ]
    }
  },
  "additionalProperties": false
}
